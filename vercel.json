{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/index.js"
    },
    {
      "source": "/transction=(.*)",
      "destination": "/index.js"
    },
    {
      "source": "/utr=(.*)",
      "destination": "/index.js"
    },
    {
      "source": "/purpose=(.*)",
      "destination": "/index.js"
    }
  ]
}
