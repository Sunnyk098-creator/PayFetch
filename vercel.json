{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/style.css", "destination": "/server.js" },
    { "source": "/script.js", "destination": "/server.js" },
    { "source": "/api.js", "destination": "/server.js" },
    { "source": "/api/fetch", "destination": "/server.js" },
    { "source": "/", "destination": "/server.js" }
  ]
}
